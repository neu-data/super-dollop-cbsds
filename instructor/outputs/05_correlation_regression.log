> set.seed(42)

> train_rows <- sample(nrow(hearts), size = round(0.7 * 
+     nrow(hearts)))

> train <- hearts[train_rows, ]

> test <- hearts[-train_rows, ]

> m_small <- lm(sbp_0 ~ age, data = train)

> m_big <- lm(sbp_0 ~ age + sex + bmi + activity_hr + 
+     smoker + district, data = train)

> rmse <- function(model, data) {
+     pred <- predict(model, newdata = data)
+     sqrt(mean((data$sbp_0 - pred)^2, na.rm = TRUE))
+ }

> c(train_small = rmse(m_small, train), test_small = rmse(m_small, 
+     test), train_big = rmse(m_big, train), test_big = rmse(m_big, 
+     test))
