> library(ggplot2)

> library(broom)

> source("R/theme_neudata.R")

> hearts <- mutate(readRDS("data/hearts.rds"), age10 = age/10)

> fit_lr0 <- glm(high_bp_0 ~ smoker, family = binomial, 
+     data = hearts)

> tidy(fit_lr0, conf.int = TRUE, exponentiate = TRUE)
