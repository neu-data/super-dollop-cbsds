> fit_lr1 <- glm(high_bp_0 ~ smoker + age10 + sex, family = binomial, 
+     data = hearts)

> tidy(fit_lr1, conf.int = TRUE, exponentiate = TRUE)
# A tibble: 4 × 7
  term        estimate std.error statistic  p.value conf.low conf.high
