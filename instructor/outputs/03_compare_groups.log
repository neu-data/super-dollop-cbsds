> set.seed(1)

> sample40 <- slice_sample(prog, n = 40)

> long40 <- mutate(bind_rows(data.frame(id = sample40$id, 
+     time = "Baseline", sbp = sample40$sbp_0), data.frame(id = sample40$id, 
+     time = "12 months", sbp = sample40$sbp_12)), time = factor(time, 
+     levels = c("Baseline", "12 months")))

> ggplot(long40, aes(x = time, y = sbp, group = id)) + 
+     geom_line(colour = "grey60") + geom_point(colour = neudata_cols[["teal"]]) + 
+     labs(x = NULL, y = "Systolic BP (mmHg)", title = "Paired data: each line joins one person's two measurements")

